# ─── Funnel (/quiz → checkout → /up1 → /up2 → /bienvenido) ─────────

# Meta Pixel of the funnel (PageView, ViewContent, InitiateCheckout).
# Purchase comes from KashPay's own Pixel integration on approved sales.
NEXT_PUBLIC_FUNNEL_PIXEL_ID=1734156964506551

# Main offer: KashPay checkout, price, optional crossed-out price (0 = none).
NEXT_PUBLIC_CHECKOUT_FRONT_URL=https://checkout.kashpay.com.br/checkout/checkout-1790282470977
NEXT_PUBLIC_PRICE_FRONT=17.90
NEXT_PUBLIC_PRICE_FRONT_FROM=0

# VSL of the main offer, from YOUR VTurb embed code:
#   <vturb-smartplayer id="vid-XXXX">  → _ID
#   s.src="https://scripts.converteai.net/.../player.js" → _SCRIPT
#   second of the video at which the offer appears → _DELAY (0 = at once)
# Defaults in lib/funnel/config.ts already point at the owner's player; set these
# only to swap the video.
NEXT_PUBLIC_VTURB_FRONT_ID=vid-6ab58aff91c2cea332a2396c
NEXT_PUBLIC_VTURB_FRONT_SCRIPT=https://scripts.converteai.net/90eef771-3dd8-46c8-b5b3-3c5b48ea076b/players/6ab58aff91c2cea332a2396c/v4/player.js
NEXT_PUBLIC_VTURB_FRONT_DELAY=615

# One-click upsells: KashPay upsell links (https://checkout.kashpay.com.br/u/...),
# price in USD, and each upsell's VSL.
NEXT_PUBLIC_KASHPAY_UP1_URL=
NEXT_PUBLIC_PRICE_UP1=0
NEXT_PUBLIC_VTURB_UP1_ID=
NEXT_PUBLIC_VTURB_UP1_SCRIPT=
NEXT_PUBLIC_VTURB_UP1_DELAY=0

NEXT_PUBLIC_KASHPAY_UP2_URL=
NEXT_PUBLIC_PRICE_UP2=0
NEXT_PUBLIC_VTURB_UP2_ID=
NEXT_PUBLIC_VTURB_UP2_SCRIPT=
NEXT_PUBLIC_VTURB_UP2_DELAY=0

# ─── Members app ─────────────────────────────────────────────────

# Tienda: KashPay checkout links for members who skipped an upsell.
NEXT_PUBLIC_CHECKOUT_UPSELL1_URL=
NEXT_PUBLIC_CHECKOUT_UPSELL2_URL=

# Price labels shown in the Tienda, exactly as they should read (e.g. "US$ 17").
NEXT_PUBLIC_PRICE_UPSELL1=
NEXT_PUBLIC_PRICE_UPSELL2=

# WhatsApp group link for the "Comunidad en WhatsApp" bonus.
NEXT_PUBLIC_WHATSAPP_URL=

# "1" shows the demo panel (unlock offers, reset progress) on a deployed build.
NEXT_PUBLIC_DEMO_MODE=
